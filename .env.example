# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- Supabase cloud persistence (server-side only — never NEXT_PUBLIC_) ----
# Used by /api/state; the browser never talks to Supabase directly.
SUPABASE_URL="https://<project-ref>.supabase.co"
# Preferred server credential: the service_role key. It bypasses RLS, so with the
# anon policies dropped (migration v2) a leaked anon key exposes nothing.
# SECRET — full DB access. Never expose with a NEXT_PUBLIC_ prefix or ship to the client.
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
# Fallback credential. Only grants access while the permissive anon RLS policies exist
# (pre-v2 / world-open). service_role takes precedence when both are set.
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
# Set to "supabase" to enable the cloud backend; otherwise the app uses localStorage only.
NEXT_PUBLIC_STORE_BACKEND="supabase"
