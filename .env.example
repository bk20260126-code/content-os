# Content OS — 환경 변수
#
# 이 파일을 .env.local로 복사한 뒤 필요한 값만 채우세요.
#   cp .env.example .env.local
#
# 아무것도 설정하지 않아도 앱은 동작합니다. 그 경우 데이터는 브라우저
# localStorage에 저장되고 AI 기능은 템플릿 모드로 대체됩니다.

# ---- AI (선택) ----
# 없으면 AI 채점·초안·게이트 평가가 비활성화되고 템플릿 초안으로 대체됩니다.
# 앱이 멈추지는 않습니다. 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ---- 클라우드 저장 (선택) ----
# 설정하지 않으면 localStorage를 씁니다. 브라우저를 지우면 데이터도 사라지고
# 다른 기기와 공유되지 않습니다.
#
# 켜는 방법:
#   1. 본인 Supabase 프로젝트 생성 (무료 플랜으로 충분)
#   2. SQL Editor에서 supabase/migrations/ 파일을 번호 순서대로 실행
#   3. 아래 세 줄을 채우기
#
# service_role 키는 RLS를 우회하는 전체 접근 권한입니다. 서버에서만 사용되며
# 브라우저는 Supabase와 직접 통신하지 않습니다. 절대 NEXT_PUBLIC_ 접두사를
# 붙이거나 클라이언트로 내보내지 마세요.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_STORE_BACKEND=""   # 클라우드 저장을 쓰려면 "supabase"

# ---- 배포용 접근 잠금 (인터넷에 올릴 때만 필수) ----
# 로컬(npm run dev)에서는 비워둬도 됩니다.
#
# 배포 환경에서 이 둘이 비어 있으면 앱은 503으로 닫힙니다. 설정을 깜빡해서
# service_role API가 공개되는 사고를 막기 위한 의도된 동작입니다.
# 길고 무작위인 값을 쓰고, HTTPS로만 배포하세요.
APP_ACCESS_USERNAME=""
APP_ACCESS_PASSWORD=""
