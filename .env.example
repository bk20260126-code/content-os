# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Required in production. Protects the entire app, including service-role API routes,
# with HTTP Basic Auth. Use long, unique values and deploy only over HTTPS.
APP_ACCESS_USERNAME="MY_APP_ACCESS_USERNAME"
APP_ACCESS_PASSWORD="MY_LONG_RANDOM_APP_ACCESS_PASSWORD"

# ---- Supabase cloud persistence (server-side only — never NEXT_PUBLIC_) ----
# Used by /api/state; the browser never talks to Supabase directly.
SUPABASE_URL="https://<project-ref>.supabase.co"
# Preferred server credential: the service_role key. It bypasses RLS, so with the
# anon policies dropped (migration v2) a leaked anon key exposes nothing.
# SECRET — full DB access. Never expose with a NEXT_PUBLIC_ prefix or ship to the client.
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
# Set to "supabase" to enable the cloud backend; otherwise the app uses localStorage only.
NEXT_PUBLIC_STORE_BACKEND="supabase"
